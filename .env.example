# =============================================================================
# CardioGuard AI — Environment Configuration
# =============================================================================
# Copy this file to .env and replace placeholders with real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=CardioGuard AI
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database ---
# SQLite (default for local dev without Docker):
DATABASE_URL=sqlite+aiosqlite:///./cardioguard.db
# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cardioguard

# --- Redis (optional in dev — graceful fallback when unavailable) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
# IMPORTANT: Replace with a random secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE-WITH-A-RANDOM-SECRET-AT-LEAST-64-CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# --- File Uploads ---
STORAGE_BACKEND=local
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_SIZE_MB=10

# --- AI / LLM (optional — app works without these) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Emergency ---
EMERGENCY_NUMBER=112
EMERGENCY_NUMBER_LABEL=Emergency Services (India)

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Celery (optional in dev) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
